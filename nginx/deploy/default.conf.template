# Docker's embedded DNS. Re-resolved periodically so replicas that are
# restarted/scaled get picked up without reloading nginx.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream backend {
    # Shared memory zone is required for runtime re-resolution
    zone backend 64k;
    least_conn;
    # `backend` resolves to the IP of every replica; `resolve` (nginx >= 1.27.3)
    # makes nginx track all of them and re-check DNS at runtime.
    server backend:8000 resolve;
}

upstream adminer {
    zone adminer 64k;
    server adminer:8080 resolve;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# HTTP: ACME challenges for certbot (webroot), everything else redirects to HTTPS
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# API, load balanced across backend replicas
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    # Certificates issued by certbot on the host (mounted read-only)
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 50m;

    location / {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }
}

# Adminer at adminer.${DOMAIN}
server {
    listen 443 ssl;
    http2 on;
    server_name adminer.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://adminer;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
