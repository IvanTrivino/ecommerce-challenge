# Copy to .env.prod and run:
#   docker compose --env-file .env.prod -f compose.prod.yml up -d --build
# The values below run the production stack on your own machine. For a real
# server, use your domain, strong secrets and real certificates.

DOMAIN=localhost
# Local only: self-signed certs from scripts/local-certs.sh. Remove on a server
# (certbot's /etc/letsencrypt is the default).
CERTS_DIR=./certs

PROJECT_NAME="E-commerce"
SECRET_KEY=change-me-to-a-long-random-string
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-too
POSTGRES_PASSWORD=change-me-as-well

# RustFS credentials (also used as the S3 keys)
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret-key
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Optional: leave SMTP_HOST empty to disable emails
# SMTP_HOST=
# EMAILS_FROM_EMAIL=
